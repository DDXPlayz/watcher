# Copy to .env and fill in. Never commit .env.
# On Render or GitHub, enter these as environment variables / repository secrets instead.

# --- Dashboard ---
# Required (12+ characters) unless HOST is 127.0.0.1
DASHBOARD_PASSWORD=
# Optional. Generated and kept in data/ if empty.
SESSION_SECRET=
HOST=127.0.0.1
PORT=8080
# Set true when served over HTTPS (Render: true)
COOKIE_SECURE=false
# Name shown in alerts from a second watcher, e.g. "github". Leave as main for the primary one.
RUNNER=main
# Where you open the dashboard from your phone (for example your Tailscale https address). Put in alarm reminders.
DASHBOARD_URL=

# --- Alert channels: every one listed here receives every alert ---
# Any of: pushover, ntfy, telegram, whatsapp, whatsapp_cloud, email
NOTIFY_PROVIDERS=

# Push: Pushover
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Push: ntfy (topic 12+ characters, random)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email over SMTP. Gmail: smtp.gmail.com, 465, ssl, your address, an app password
SMTP_HOST=
SMTP_PORT=465
# ssl (port 465), starttls (port 587) or none
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# One or more addresses, comma-separated
EMAIL_TO=

# WhatsApp through CallMeBot (personal use). Phone with country code, e.g. +919812345678
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# WhatsApp Cloud API (Meta). Needs an approved template with two body variables: {{1}} alert, {{2}} link
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_TO=
WA_CLOUD_TEMPLATE=
WA_CLOUD_LANGUAGE=en
WA_CLOUD_API_VERSION=v23.0

# --- Dead-man's switch (recommended): a URL pinged while the watcher is healthy ---
HEARTBEAT_URL=

# --- District is on in config.yaml. Set false here to switch it off ---
DISTRICT_TERMS_ACK=
